# =============================================
# Script: Reset AnyDesk Contador/Timer - Versão 3 (Corrigida)
# =============================================

param(
    [switch]$KeepID = $true
)

function Test-Admin {
    $currentUser = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    return $currentUser.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

if (-not (Test-Admin)) {
    Write-Host "ERRO: Execute como Administrador!" -ForegroundColor Red
    pause; exit 1
}

Write-Host "Iniciando reset do contador AnyDesk..." -ForegroundColor Green

# Caminhos
$anydeskExe     = "C:\Program Files (x86)\AnyDesk\AnyDesk.exe"
$programData    = "C:\ProgramData\AnyDesk"
$appData        = "$env:APPDATA\AnyDesk"

# Parar AnyDesk
Write-Host "Parando AnyDesk..." -ForegroundColor Yellow
Get-Process -Name "AnyDesk*" -ErrorAction SilentlyContinue | Stop-Process -Force
Stop-Service -Name "AnyDesk" -Force -ErrorAction SilentlyContinue
Start-Sleep -Seconds 3

# Backup do histórico do usuário
$backupPath = "$env:TEMP\AnyDesk_Backup_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
New-Item -ItemType Directory -Path $backupPath -Force | Out-Null

$filesToBackup = @("user.conf", "thumbnails")

Write-Host "Fazendo backup do historico..." -ForegroundColor Cyan
foreach ($item in $filesToBackup) {
    $source = Join-Path $appData $item
    if (Test-Path $source) {
        Copy-Item -Path $source -Destination $backupPath -Recurse -Force
    }
}

# Reset do contador
Write-Host "Resetando arquivos do contador..." -ForegroundColor Yellow

$filesToReset = @("connection_trace.txt", "ad.trace", "ad_svc.trace")

if (Test-Path $programData) {
    foreach ($file in $filesToReset) {
        Remove-Item "$programData\$file" -Force -ErrorAction SilentlyContinue
    }
    
    # Tratamento para service.conf e system.conf
    if ($KeepID) {
        $confFiles = @("service.conf", "system.conf")
        foreach ($conf in $confFiles) {
            $fullPath = "$programData\$conf"
            $bakPath  = "$programData\$conf.bak"
            
            if (Test-Path $fullPath) {
                if (Test-Path $bakPath) {
                    Remove-Item $bakPath -Force
                }
                Rename-Item $fullPath "$conf.bak" -Force
                Write-Host " $conf renomeado para backup" -ForegroundColor Green
            }
        }
    } else {
        Remove-Item "$programData\service.conf" -Force -ErrorAction SilentlyContinue
        Remove-Item "$programData\system.conf" -Force -ErrorAction SilentlyContinue
    }
}

# Reset no AppData
if (Test-Path $appData) {
    foreach ($file in $filesToReset) {
        Remove-Item "$appData\$file" -Force -ErrorAction SilentlyContinue
    }
}

# Restaurar histórico
Write-Host "Restaurando historico e nomes renomeados..." -ForegroundColor Cyan
foreach ($item in $filesToBackup) {
    $source = Join-Path $backupPath $item
    $dest   = Join-Path $appData $item
    if (Test-Path $source) {
        Copy-Item -Path $source -Destination $dest -Recurse -Force
    }
}

# Iniciar AnyDesk
Write-Host "Iniciando AnyDesk..." -ForegroundColor Green
if (Test-Path $anydeskExe) {
    Start-Process -FilePath $anydeskExe
    Write-Host "AnyDesk iniciado!" -ForegroundColor Green
} else {
    Write-Host "AnyDesk.exe nao encontrado!" -ForegroundColor Yellow
}

Write-Host "Reset concluido com sucesso!" -ForegroundColor Green
Write-Host "Backup temporario: $backupPath" -ForegroundColor Gray
pause
