# Autor: Ederson Pens
# =====================================================

$ErrorActionPreference = "Stop"

# Verificar administrador
$admin = ([Security.Principal.WindowsPrincipal]`
    [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)

if (-not $admin) {
    Start-Process powershell.exe -Verb RunAs -ArgumentList `
        "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    exit
}

Write-Host "`n=== ANYDESK MANUTENCAO ===" -ForegroundColor Cyan

# Localizar diretorios
$paths = @(
    "$env:ProgramData\AnyDesk",
    "$env:APPDATA\AnyDesk",
    "$env:LOCALAPPDATA\AnyDesk"
)

# Backup
$backup = "$env:USERPROFILE\Desktop\Backup_AnyDesk_$(Get-Date -Format 'yyyyMMdd_HHmmss')"

New-Item -ItemType Directory -Path $backup -Force | Out-Null

Write-Host "[1/4] Preservando configuracoes..." -ForegroundColor Cyan

foreach ($path in $paths) {
    if (Test-Path $path) {
        $name = Split-Path $path -Leaf
        Copy-Item $path "$backup\$name" -Recurse -Force
        Write-Host "Backup realizado: $path" -ForegroundColor Green
    }
}

# Localizar servico
Write-Host "[2/4] Verificando servico..." -ForegroundColor Cyan

$service = Get-Service -Name "AnyDesk" -ErrorAction SilentlyContinue

if (-not $service) {
    Write-Warning "Servico AnyDesk nao encontrado."
    Write-Host "Verifique se o AnyDesk esta instalado."
    exit
}

# Encerrar processo
Write-Host "[3/4] Reiniciando AnyDesk..." -ForegroundColor Cyan

Stop-Process -Name "AnyDesk" -Force -ErrorAction SilentlyContinue

if ($service.Status -ne "Stopped") {
    Stop-Service -Name "AnyDesk" -Force
}

Start-Sleep -Seconds 3

Start-Service -Name "AnyDesk"

# Validar
Write-Host "[4/4] Validando funcionamento..." -ForegroundColor Cyan

Start-Sleep -Seconds 5

$service = Get-Service -Name "AnyDesk"

if ($service.Status -eq "Running") {
    Write-Host "`nSERVICO FUNCIONANDO!" -ForegroundColor Green
} else {
    Write-Warning "O servico nao iniciou corretamente."
}

Write-Host "`nBackup salvo em:" -ForegroundColor Yellow
Write-Host $backup

Write-Host "`nManutencao concluida." -ForegroundColor Green
